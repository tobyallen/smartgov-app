model
  schema 1.1

type user

type agent

type case
  relations
    # Human ownership — granted automatically at case creation, never
    # toggled. Gates the citizen's own view of their own case.
    define owner: [user]

    # Delegation — toggled on/off live by the citizen, and now also
    # self-expiring: granted_at is stamped by setAgentDelegation at grant
    # time and re-read fresh on every check, the same pattern
    # agent_can_submit_appeal already uses for appeal_window. Gates the
    # agent's chat replies and most MCP tool calls (e.g. check_case_status).
    define agent_delegate: [agent with delegation_window]

    # A second, conditioned relation written/removed by the SAME toggle
    # action as agent_delegate (see setAgentDelegation). Gates only the
    # submit_appeal tool: delegation must be granted AND the case must
    # still be inside its appeal window.
    define agent_can_submit_appeal: [agent with appeal_window]

# The MCP vignette's admin surface: a separate type from `case`, because
# contractor management is a distinct resource with its own grant, not a
# citizen-owned document. Two relations on the same object, same seeding
# action — mirroring case's owner/agent_delegate/agent_can_submit_appeal
# split above. `caseworker_managed` is the plain, unconditional grant
# (list/single-disable); `caseworker_can_bulk_disable` additionally
# requires a fresh, server-asserted step-up approval, checked at call time
# via the step_up_approved condition — never a flag the caller supplies
# about itself (see /api/request-step-up).
type contractor
  relations
    define caseworker_managed: [user]
    define caseworker_can_bulk_disable: [user with step_up_approved]

condition appeal_window(current_time: timestamp, assessment_time: timestamp) {
  current_time < assessment_time + duration("720h")
}

# 15 minutes: short enough to plausibly fire during a single workshop
# session without a manual revoke. See /api/delegation's DELETE-and-debug
# "expire now" escape hatch for demo reliability if real elapsed time
# doesn't cooperate on the day.
condition delegation_window(current_time: timestamp, granted_at: timestamp) {
  current_time < granted_at + duration("15m")
}

condition step_up_approved(approved_at: timestamp, current_time: timestamp) {
  current_time < approved_at + duration("5m")
}
