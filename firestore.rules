rules_version = '2';

// All reads/writes to these collections go through server-side Admin SDK
// calls (Next.js route handlers, using a service account that bypasses
// these rules entirely). No client ever authenticates to Firebase - the
// app's identity system is Auth0 only - so there is no `request.auth` to
// scope a client-side rule to. Deny all direct client access; the server
// routes are the only enforced boundary.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
